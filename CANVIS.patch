+                                  ("c", 189, 10, False)]:
+            f = F(100 + p, 100) if puja else F(100 - p, 100)
+            self.assertEqual(F(final) / f, num(clau(self._it("277" + a))))
+
+    def test_descomptes_encadenats_no_se_sumen(self):
