+  "EIX_SIMETRIA_MAL_CALCULAT": "L'eix de simetria és la recta vertical que passa pel vèrtex: $x=\\frac{-b}{2a}$. És una recta, no un número solt ni un punt.",
+  "EXTREMS_OBLIDATS": "T'has deixat els extrems de l'interval. Quan el domini està limitat, els valors dels extrems compten.",
+  "EXTREM_INVERTIT": "Has confós el màxim amb el mínim. Amb una paràbola ho decideix el signe de $a$: positiu, mínim; negatiu, màxim.",
   "INVERTIDA": "Has invertit la fracció. Simplificar no canvia quin terme és a dalt i quin a baix.",
+  "OBERTURA_INVERTIDA": "Com més gran és $|a|$, més ESTRETA és la paràbola, no més ampla: el coeficient estira la corba cap amunt.",
+  "OBERTURA_I_AMPLADA_INVERTIDES": "Has invertit la relació entre el coeficient i la forma de la corba: compara dues paràboles concretes ($y=x^2$ i $y=3x^2$) i mira quina és més estreta.",
+  "OPERACIO_INVERSA": "Has fet l'operació contrària a la que tocava per desfer el pas anterior.",
+  "ORDENADA_NULA_OBLIDADA": "Quan la recta passa per l'origen, l'ordenada a l'origen val $0$ i el terme independent desapareix: $y=mx$.",
+  "ORDENADA_PER_COORDENADA": "Has pres la $y$ d'un punt com a ordenada a l'origen. Només coincideixen si aquell punt és sobre l'eix $Y$, és a dir, si té $x=0$.",
+  "ORDENADES_PER_TALL": "Has donat on talla cada recta l'eix $Y$. El punt de tall ENTRE dues rectes és on totes dues valen el mateix alhora.",
+  "PARABOLA_AMB_A_ZERO": "Si $a=0$ no hi ha terme en $x^2$ i allò no és cap paràbola, sinó una recta.",
+  "PARALLELA_MATEIXA_RECTA": "La recta que has donat és la de partida. Una paral·lela té el mateix pendent però una altra ordenada a l'origen, o serien la mateixa recta.",
+  "PARALLELA_PER_PERPENDICULAR": "Has confós paral·lela amb perpendicular. Les paral·leles comparteixen pendent; les perpendiculars el tenen invers i canviat de signe.",
+  "PART_FIXA_VARIABLE_BARREJADES": "Has barrejat la part fixa amb la variable. La que es paga sempre és el terme independent; la que depèn de la quantitat és el pendent.",
+  "PAS_INTERMEDI_PER_RESPOSTA": "El valor que has triat és correcte, però és un pas intermedi, no el que et demanen. Torna a llegir la pregunta i mira quina magnitud has d'acabar donant: sovint només falta una operació més.",
   "PENDENT_COM_NUL": "Una funció afí només és constant si el pendent és $0$. Si el pendent és qualsevol altre nombre, la funció puja o baixa sempre.",
+  "PENDENT_INVERTIT": "Has calculat $\\frac{\\Delta x}{\\Delta y}$. El pendent és $\\frac{\\Delta y}{\\Delta x}$: el que puja entre el que avança.",
+  "PENDENT_MAL_TRIAT": "El pendent que has fet servir no és el que toca. Si te'l donen, es col·loca tal com és; si no, es calcula amb dos punts.",
+  "PENDENT_NOMES_CANVIAT_DE_SIGNE": "Per a una perpendicular no n'hi ha prou de canviar el signe del pendent: també cal invertir-lo, perquè el producte dels dos pendents ha de valer $-1$.",
   "PENDENT_ORDENADA_INTERCANVIATS": "El pendent és el nombre que MULTIPLICA la $x$; l'ordenada a l'origen és el terme independent, el que va sol. Els has intercanviat.",
+  "POTENCIA_APLICADA_MALAMENT": "La potència no s'ha aplicat a tot el que havia d'afectar: mira bé què queda dins del parèntesi.",
   "POTENCIA_COM_PRODUCTE": "$x^2$ no és $2x$: és $x\\cdot x$. Prova-ho amb $x=3$, que dona $9$ i no $6$.",
+  "PRODUCTE_PER_SUMA": "Has sumat on tocava multiplicar (o al revés). Torna a llegir quina operació es fa sobre les dades.",
+  "PUNT_ORDENADA_CONFOS": "Has confós un punt de la gràfica amb l'ordenada a l'origen. Només coincideixen si el punt té $x=0$.",
+  "RECTA_VERTICAL_CONFOSA": "Has confós una recta horitzontal amb una de vertical. Les horitzontals són $y=$ constant; les verticals, $x=$ constant, i aquestes no són funcions.",
+  "RELATIU_COM_ABSOLUT": "Has comparat valors absoluts on calia comparar-los en proporció, o al revés.",
   "REPRESENTACIO_INNECESSARIA": "No cal dibuixar la gràfica: el signe del pendent ja diu si la funció creix o decreix, i el de $a$ si la paràbola s'obre amunt o avall.",
+  "RESTRICCIO_INVENTADA": "Has exclòs valors que sí que són al domini. Comprova què impedeix de debò calcular la imatge.",
+  "RESTRICCIO_OBLIDADA": "T'has deixat una restricció del domini: hi ha valors de $x$ que la funció no admet.",
+  "SIGNE_ARRELS": "Les arrels tenen el signe canviat. Comprova-les substituint-les: han de fer que la funció valgui $0$.",
+  "SIGNE_COEFICIENT_PRINCIPAL": "El signe de $a$ no encaixa amb la forma de la paràbola. Si $a>0$ s'obre cap amunt i el vèrtex és un mínim; si $a<0$, cap avall i és un màxim.",
   "SIGNE_FINAL": "El resultat té el signe canviat. Revisa quin dels dos termes és més gran en valor absolut.",
+  "SIGNE_ORDENADA_INVERTIT": "L'ordenada a l'origen té el signe canviat: mira si la recta talla l'eix vertical per damunt o per sota del zero.",
   "SIGNE_PENDENT_INVERTIT": "El pendent conserva el signe amb què apareix a l'expressió: no cal canviar-l'hi en llegir-lo.",
   "SIGNE_TERME_INDEPENDENT": "Revisa el signe del terme independent (el que no porta $x$): és fàcil perdre'l en sumar o restar.",
+  "SIGNE_VERTEX": "T'has deixat el signe menys de $x_v=\\frac{-b}{2a}$. És l'error més habitual amb el vèrtex, i es detecta de seguida mirant si el vèrtex cau on hauria de caure.",
+  "SUBSTITUCIO_MAL_FETA": "La primera part surt bé, però en substituir per trobar la segona hi ha un error. Comprova el resultat posant-lo a l'expressió original.",
   "SUMA_EN_LLOC_RESTA": "Sumar un nombre negatiu és restar-lo.",
+  "TALL_COM_EXTREM": "Has confós un tall amb l'eix amb el màxim o el mínim. Als talls la funció val zero; a l'extrem hi arriba al seu valor més alt o més baix.",
+  "TALL_ORIGEN_OBLIDAT": "T'has deixat el tall amb un dels eixos. Amb l'eix $Y$ n'hi ha sempre un i només un: el valor de la funció a $x=0$.",
+  "TERMES_NO_REDUITS": "Falta reduir els termes semblants abans de treure conclusions: l'expressió encara es pot simplificar.",
+  "TERME_INDEPENDENT_IGNORAT": "T'has deixat el terme independent. Encara que vagi sol, forma part de la funció.",
   "TERME_OBLIDAT_OPERACIO": "T'has deixat algun terme pel camí en combinar els polinomis: revisa'ls tots un per un, grau a grau.",
-  "VEREDICTE_INVERTIT": "El veredicte (cert/fals, o sí/no) que has triat és l'oposat del correcte: torna a comprovar la condició amb els valors concrets de l'enunciat."
+  "VALOR_C_CONFOS": "El terme independent $c$ és el valor de la funció a $x=0$, no cap altra cosa.",
+  "VALOR_DUPLICAT": "Has comptat dues vegades el mateix valor. Quan dues condicions donen la mateixa solució, la solució és una de sola.",
+  "VEREDICTE_INVERTIT": "El veredicte (cert/fals, o sí/no) que has triat és l'oposat del correcte: torna a comprovar la condició amb els valors concrets de l'enunciat.",
+  "VERTEX_COM_COEFICIENTS": "Has col·locat les coordenades del vèrtex com a coeficients de la funció. Per anar del vèrtex a l'equació cal la forma $y=a(x-x_v)^2+y_v$.",
+  "VERTEX_PER_ARREL": "Has donat una arrel (on la funció val zero) en comptes del vèrtex (on arriba al màxim o al mínim). Són coses diferents."
  },
