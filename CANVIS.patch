+          return '<div class="petit" style="margin:.25rem 0"><span class="xip">' + e[1] + "×</span> "
+            + '<span class="mono">' + e[0] + "</span></div>";
+        }).join("") : '<p class="petit apagat" style="margin:0">Cap.</p>') + "</div>";
+
+    $("#agregat").innerHTML = h + "</div>";
+  }
+
+  // ── accions ────────────────────────────────────────────────────────────
+  function carrega(txt) {
+    var brut = llegeixFull(txt);
+    if (!brut.length) {
+      $("#estat-carrega").innerHTML = '<span class="mal">No hi he trobat cap codi. '
+        + "Els codis comencen per RC1.</span>";
+      return;
+    }
+    files = processa(brut);
+    obert = null;
+    var sel = $("#f-full");
+    var vistos = [];
+    files.forEach(function (r) { if (r.p.ok) r.p.fulls.forEach(function (f) { if (vistos.indexOf(f.n) < 0) vistos.push(f.n); }); });
+    vistos.sort(function (a, b) { return a - b; });
+    sel.innerHTML = '<option value="">Tots els fulls</option>'
+      + vistos.map(function (n) { return '<option value="' + n + '">Full ' + n + "</option>"; }).join("");
+    $("#estat-carrega").innerHTML = '<span class="ok">' + files.length + " codis llegits</span>";
+    $("#resultats").hidden = false;
+    pinta();
+  }
+
+  $("#btn-llegeix").onclick = function () { carrega($("#entrada").value); };
+  $("#fitxer").onchange = function (e) {
+    var f = e.target.files[0];
+    if (!f) return;
+    var r = new FileReader();
+    r.onload = function () { $("#entrada").value = r.result; carrega(r.result); };
+    r.readAsText(f, "utf-8");
+  };
+  ["#f-text", "#f-full", "#f-estat"].forEach(function (s) {
+    $(s).oninput = pinta; $(s).onchange = pinta;
+  });
+
+  $("#btn-csv").onclick = function () {
+    var ult = ultimPerAlumne(filtra());
+    var l = ["alumne;grup;exercicis;nota;fulls;data"];
+    ult.forEach(function (r) {
+      l.push([r.brut.alumne, r.brut.grup, r.p.resum.fets,
+              r.p.resum.nota === null ? "" : String(r.p.resum.nota).replace(".", ","),
+              r.p.fulls.map(function (f) { return f.n; }).join(" "), r.dataGen].join(";"));
+    });
+    var b = new Blob(["\ufeff" + l.join("\n")], { type: "text/csv;charset=utf-8" });
+    var a = document.createElement("a");
+    a.href = URL.createObjectURL(b); a.download = "repas-eso-resum.csv"; a.click();
+  };
+
+  $("#btn-exemple").onclick = function () {
+    var noms = ["berta", "jordi", "laia", "marc", "nil", "ona"];
+    var opc = ["net", "net", "net", "segon", "pista", "fallat"];
+    var l = ["Marca temporal\tAdreça electrònica\tGrup\tCodi"];
+    noms.forEach(function (nom, k) {
+      var quins = [4, 7].slice(0, 1 + (k % 2));
+      var fulls = quins.map(function (n) {
+        var t = RE_TAULES.fulls[n];
+        var quants = 6 + Math.floor(Math.random() * (t.items.length - 6));
+        return { n: n, estats: t.items.map(function (_, i) { return i < quants ? opc[Math.floor(Math.random() * 6)] : ""; }) };
+      });
+      var ara = new Date(); ara.setMinutes(ara.getMinutes() - Math.floor(Math.random() * 90));
+      var codi = RE_CODI.genera({
+        fulls: fulls, ara: ara,
+        errs: [["SIGNE_FINAL", 3 + k], ["PAS_INTERMEDI_PER_RESPOSTA", 2]]
+      });
+      if (k === 5) codi = codi.slice(0, 12) + "X" + codi.slice(13);   /* un de manipulat */
+      var d = new Date();
+      l.push([("0" + d.getDate()).slice(-2) + "/" + ("0" + (d.getMonth() + 1)).slice(-2) + "/" + d.getFullYear()
+              + " " + ("0" + d.getHours()).slice(-2) + ":" + ("0" + d.getMinutes()).slice(-2) + ":00",
+              nom + "@escola.cat", k < 3 ? "4tA" : "4tB", codi].join("\t"));
+    });
+    $("#entrada").value = l.join("\n");
+    carrega($("#entrada").value);
+  };
+
+  // ── un sol codi ────────────────────────────────────────────────────────
+  $("#btn-un").onclick = function () {
+    var raw = $("#codi-un").value.trim();
+    if (!raw) return;
+    files = processa([{ codi: raw, alumne: "—", grup: "", enviat: "" }]);
+    obert = 0;
+    var r = files[0];
+    var h = '<table><tbody>' + (r.p.ok ? detall(r).replace('colspan="9"', 'colspan="1"')
+                                       : detall(r).replace('colspan="9"', 'colspan="1"')) + "</tbody></table>";
+    $("#un-resultat").innerHTML = "<div class=\"targeta\">" + marca(r.estat) + " "
+      + (r.p.ok ? (r.p.integre ? "Codi íntegre" : "Codi alterat o mal copiat") : "No s'ha pogut llegir")
+      + "</div>" + h;
+  };
+})();
+</script>
+</body>
+</html>
