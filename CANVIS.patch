+    assert.ok(/fabrica un codi des de la consola/.test(t), "falta el forat de la consola");
+    assert.ok(/amb ajuda al costat/.test(t), "falta el forat de l'ajuda externa");
+  });
+
+  prova("no promet garantir l'autoria", () => {
