+  function dada(k, v) { return '<div class="dada"><b>' + k + "</b>" + v + "</div>"; }
+
+  /* Un alumne pot enviar diverses vegades. Val el codi més recent, que és
+     acumulatiu i ja conté tot el que hi havia als anteriors. */
+  function ultimPerAlumne(fs) {
+    var m = {};
+    fs.forEach(function (r) {
+      if (!r.p.ok) return;
+      var k = r.brut.alumne + "|" + r.brut.grup;
+      var t = r.p.data.getTime() + (r.p.hora * 60 + r.p.minut) * 60000;
+      if (!m[k] || t >= m[k].t) m[k] = { t: t, r: r };
+    });
+    return Object.keys(m).map(function (k) { return m[k].r; })
+      .sort(function (a, b) { return a.brut.alumne.localeCompare(b.brut.alumne); });
+  }
+
+  function pintaAlumnes(fs) {
+    var ult = ultimPerAlumne(fs);
+    if (!ult.length) { $("#t-alumnes").innerHTML = '<tr><td class="buit">Cap codi vàlid amb aquests filtres</td></tr>'; return; }
+    var fullsVistos = [];
+    ult.forEach(function (r) { r.p.fulls.forEach(function (f) { if (fullsVistos.indexOf(f.n) < 0) fullsVistos.push(f.n); }); });
+    fullsVistos.sort(function (a, b) { return a - b; });
+
+    var h = "<thead><tr><th>Alumne</th><th>Grup</th><th>Fets</th><th>Nota</th>";
+    fullsVistos.forEach(function (n) { h += "<th>F" + n + "</th>"; });
+    h += "<th>Últim codi</th></tr></thead><tbody>";
+    ult.forEach(function (r) {
+      var p = r.p;
+      h += "<tr><td>" + r.brut.alumne + '</td><td class="apagat">' + (r.brut.grup || "—") + "</td>"
+        + "<td>" + p.resum.fets + "</td><td>" + pintaNota(p.resum.nota) + "</td>";
+      fullsVistos.forEach(function (n) {
+        var f = p.fulls.filter(function (x) { return x.n === n; })[0];
+        if (!f) { h += '<td class="apagat">·</td>'; return; }
+        var fets = f.items.filter(function (x) { return x.estat && x.estat !== "vist"; }).length;
+        h += '<td class="mono petit">' + fets + "/" + f.items.length + "</td>";
+      });
+      h += '<td class="mono petit apagat">' + r.dataGen + "</td></tr>";
+    });
+    $("#t-alumnes").innerHTML = h + "</tbody>";
+  }
+
+  /* Agregat de classe: quins exercicis falla més gent i quins errors es
+     repeteixen. És el que diu al professorat què cal tornar a explicar. */
+  function pintaAgregat(fs) {
+    var ult = ultimPerAlumne(fs);
+    if (!ult.length) { $("#agregat").innerHTML = '<div class="buit">Res a agregar</div>'; return; }
+    var perItem = {}, perErr = {}, perBloc = {};
+    ult.forEach(function (r) {
+      r.p.fulls.forEach(function (f) {
+        f.items.forEach(function (it) {
+          if (it.estat === "fallat" || it.estat === "pista") {
+            var k = f.n + "|" + it.id;
+            perItem[k] = (perItem[k] || 0) + (it.estat === "fallat" ? 2 : 1);
+          }
+        });
+        f.blocs.forEach(function (b) {
+          var dins = f.items.slice(b[1], b[2] + 1);
+          var fets = dins.filter(function (x) { return x.estat && x.estat !== "vist"; }).length;
+          if (!fets) return;
+          var mal = dins.filter(function (x) { return x.estat === "fallat"; }).length;
+          var k = f.n + " · " + b[0];
+          if (!perBloc[k]) perBloc[k] = { fets: 0, mal: 0, alumnes: 0 };
+          perBloc[k].fets += fets; perBloc[k].mal += mal; perBloc[k].alumnes++;
+        });
+      });
+      r.p.errs.forEach(function (e) { perErr[e.etiqueta] = (perErr[e.etiqueta] || 0) + e.compte; });
+    });
+
+    var itemsMal = Object.keys(perItem).map(function (k) { return [k, perItem[k]]; })
+      .sort(function (a, b) { return b[1] - a[1]; }).slice(0, 20);
+    var errsMal = Object.keys(perErr).map(function (k) { return [k, perErr[k]]; })
+      .sort(function (a, b) { return b[1] - a[1]; }).slice(0, 10);
+    var blocsMal = Object.keys(perBloc).map(function (k) { return [k, perBloc[k]]; })
+      .filter(function (x) { return x[1].fets >= 3; })
+      .sort(function (a, b) { return (b[1].mal / b[1].fets) - (a[1].mal / a[1].fets); }).slice(0, 8);
+
+    var h = '<div class="graella" style="grid-template-columns:repeat(auto-fit,minmax(280px,1fr))">';
+    h += '<div class="targeta"><h3>Blocs on més s\'encalla la classe</h3>'
+      + (blocsMal.length ? blocsMal.map(function (b) {
+          var pc = Math.round(100 * b[1].mal / b[1].fets);
+          return '<div class="petit" style="margin:.3rem 0"><b>' + pc + "%</b> fallats · "
+            + b[0] + ' <span class="apagat">(' + b[1].alumnes + " alumnes)</span></div>";
+        }).join("") : '<p class="petit apagat" style="margin:0">Encara no hi ha prou dades.</p>') + "</div>";
+
+    h += '<div class="targeta"><h3>Exercicis que costen més</h3>'
+      + (itemsMal.length ? itemsMal.map(function (x) {
+          var t = x[0].split("|");
+          return '<span class="xip" title="Full ' + t[0] + '">' + t[0] + "/" + t[1] + "</span>";
+        }).join("") : '<p class="petit apagat" style="margin:0">Cap.</p>') + "</div>";
+
+    h += '<div class="targeta"><h3>Errors que més es repeteixen</h3>'
+      + (errsMal.length ? errsMal.map(function (e) {
+          return '<div class="petit" style="margin:.25rem 0"><span class="xip">' + e[1] + "×</span> "
+            + '<span class="mono">' + e[0] + "</span></div>";
+        }).join("") : '<p class="petit apagat" style="margin:0">Cap.</p>') + "</div>";
+
+    $("#agregat").innerHTML = h + "</div>";
+  }
+
+  // ── accions ────────────────────────────────────────────────────────────
+  function carrega(txt) {
+    var brut = llegeixFull(txt);
+    if (!brut.length) {
+      $("#estat-carrega").innerHTML = '<span class="mal">No hi he trobat cap codi. '
+        + "Els codis comencen per RC1.</span>";
+      return;
+    }
+    files = processa(brut);
+    obert = null;
+    var sel = $("#f-full");
+    var vistos = [];
+    files.forEach(function (r) { if (r.p.ok) r.p.fulls.forEach(function (f) { if (vistos.indexOf(f.n) < 0) vistos.push(f.n); }); });
+    vistos.sort(function (a, b) { return a - b; });
+    sel.innerHTML = '<option value="">Tots els fulls</option>'
+      + vistos.map(function (n) { return '<option value="' + n + '">Full ' + n + "</option>"; }).join("");
+    $("#estat-carrega").innerHTML = '<span class="ok">' + files.length + " codis llegits</span>";
+    $("#resultats").hidden = false;
+    pinta();
+  }
+
+  $("#btn-llegeix").onclick = function () { carrega($("#entrada").value); };
+  $("#fitxer").onchange = function (e) {
+    var f = e.target.files[0];
+    if (!f) return;
+    var r = new FileReader();
+    r.onload = function () { $("#entrada").value = r.result; carrega(r.result); };
+    r.readAsText(f, "utf-8");
+  };
+  ["#f-text", "#f-full", "#f-estat"].forEach(function (s) {
+    $(s).oninput = pinta; $(s).onchange = pinta;
+  });
+
+  $("#btn-csv").onclick = function () {
+    var ult = ultimPerAlumne(filtra());
+    var l = ["alumne;grup;exercicis;nota;fulls;data"];
+    ult.forEach(function (r) {
+      l.push([r.brut.alumne, r.brut.grup, r.p.resum.fets,
+              r.p.resum.nota === null ? "" : String(r.p.resum.nota).replace(".", ","),
+              r.p.fulls.map(function (f) { return f.n; }).join(" "), r.dataGen].join(";"));
+    });
+    var b = new Blob(["\ufeff" + l.join("\n")], { type: "text/csv;charset=utf-8" });
+    var a = document.createElement("a");
+    a.href = URL.createObjectURL(b); a.download = "repas-eso-resum.csv"; a.click();
+  };
+
+  $("#btn-exemple").onclick = function () {
+    var noms = ["berta", "jordi", "laia", "marc", "nil", "ona"];
+    var opc = ["net", "net", "net", "segon", "pista", "fallat"];
+    var l = ["Marca temporal\tAdreça electrònica\tGrup\tCodi"];
+    noms.forEach(function (nom, k) {
+      var quins = [4, 7].slice(0, 1 + (k % 2));
+      var fulls = quins.map(function (n) {
+        var t = RE_TAULES.fulls[n];
+        var quants = 6 + Math.floor(Math.random() * (t.items.length - 6));
+        return { n: n, estats: t.items.map(function (_, i) { return i < quants ? opc[Math.floor(Math.random() * 6)] : ""; }) };
+      });
+      var ara = new Date(); ara.setMinutes(ara.getMinutes() - Math.floor(Math.random() * 90));
+      var codi = RE_CODI.genera({
+        fulls: fulls, ara: ara,
+        errs: [["SIGNE_FINAL", 3 + k], ["PAS_INTERMEDI_PER_RESPOSTA", 2]]
+      });
+      if (k === 5) codi = codi.slice(0, 12) + "X" + codi.slice(13);   /* un de manipulat */
+      var d = new Date();
+      l.push([("0" + d.getDate()).slice(-2) + "/" + ("0" + (d.getMonth() + 1)).slice(-2) + "/" + d.getFullYear()
+              + " " + ("0" + d.getHours()).slice(-2) + ":" + ("0" + d.getMinutes()).slice(-2) + ":00",
+              nom + "@escola.cat", k < 3 ? "4tA" : "4tB", codi].join("\t"));
+    });
+    $("#entrada").value = l.join("\n");
+    carrega($("#entrada").value);
+  };
+
+  // ── un sol codi ────────────────────────────────────────────────────────
+  $("#btn-un").onclick = function () {
+    var raw = $("#codi-un").value.trim();
+    if (!raw) return;
+    files = processa([{ codi: raw, alumne: "—", grup: "", enviat: "" }]);
+    obert = 0;
+    var r = files[0];
+    var h = '<table><tbody>' + (r.p.ok ? detall(r).replace('colspan="9"', 'colspan="1"')
+                                       : detall(r).replace('colspan="9"', 'colspan="1"')) + "</tbody></table>";
+    $("#un-resultat").innerHTML = "<div class=\"targeta\">" + marca(r.estat) + " "
+      + (r.p.ok ? (r.p.integre ? "Codi íntegre" : "Codi alterat o mal copiat") : "No s'ha pogut llegir")
+      + "</div>" + h;
+  };
+})();
+</script>
+</body>
+</html>
